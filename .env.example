# ===========================================================================
# esiyat-robot — örnek ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# GERÇEK anahtarları ASLA commit etmeyin — `.env` .gitignore ile dışlanır.
# ===========================================================================

# Uygulama
APP_NAME=esiyat-robot
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- GÜVENLİK / EMİR MODU ---
# Paper trading varsayılan ve zorunludur. Gerçek emir gönderimi kapalıdır.
# TRADING_MODE yalnızca "paper" değerini kabul eder (kod seviyesinde zorlanır).
TRADING_MODE=paper
# Gerçek emir gönderimini açıkça devre dışı bırakır. true olarak bırakın.
LIVE_TRADING_DISABLED=true
# Acil durum durdurma. true iken hiçbir emir (paper dahil) işlenmez.
KILL_SWITCH=false
# Kimlik doğrulama eklenene kadar kill-switch yönetim endpoint'i kapalıdır.
# Yalnızca yerel geliştirmede bilinçli test için true yapılmalıdır.
ENABLE_KILL_SWITCH_ENDPOINT=false

# --- RİSK PARAMETRELERİ (yüzde/oran) ---
MAX_RISK_PER_TRADE=0.01      # İşlem başına azami risk %1
MAX_ASSET_WEIGHT=0.10        # Tek varlık azami ağırlığı %10
MAX_DAILY_LOSS=0.03          # Günlük azami zarar %3
MAX_PORTFOLIO_DRAWDOWN=0.10  # Portföy azami düşüşü %10

# --- BROKER (yalnızca stub — anahtarları buraya koymayın, .env'e koyun) ---
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_BASE_URL=
